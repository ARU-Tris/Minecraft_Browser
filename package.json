{
  "name": "minecraft-browser",
  "version": "0.2.0",
  "private": true,
  "description": "MINECRAFT? personal desktop browser",
  "author": "ARU_Tris",
  "main": "browser/main.cjs",
  "scripts": {
    "start": "node tools/start.cjs",
    "test": "node tools/test.cjs",
    "test:native": "node tools/native-smoke.cjs",
    "build:installer": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "6.2.6"
  },
  "build": {
    "appId": "io.arutris.minecraftbrowser",
    "productName": "Minecraft Browser",
    "executableName": "Minecraft Browser",
    "copyright": "Personal project by ARU_Tris",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "browser/**/*.cjs",
      "design/*.html",
      "design/*.js",
      "design/*.css",
      "assets/**/*",
      "docs/RELEASE.md",
      "package.json",
      "!assets/**/*.sources.json",
      "!assets/**/sources.json",
      "!**/*.pyc"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/browser.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MINECRAFT",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Minecraft-Browser-Setup-${version}-${arch}.${ext}"
    }
  }
}
